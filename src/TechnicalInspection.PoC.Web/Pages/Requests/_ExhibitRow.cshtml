@model ExhibitInput
@{
    // The prefix this row was rendered under. Create.js rewrites it (and every name/id below it)
    // when rows are added, removed or cloned out of a template.
    var prefix = Html.Name(string.Empty);
}

<div class="card mb-3" data-row="exhibit" data-prefix="@prefix">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Exhibit #<span data-exhibit-number>@Model.SequenceNumber</span></strong>
        <button type="button" class="btn btn-sm btn-outline-danger" data-action="remove-exhibit">
            Remove exhibit
        </button>
    </div>
    <div class="card-body">
        <input type="hidden" asp-for="SequenceNumber" data-field="sequence" />

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Exhibit description</label>
            <input asp-for="Description" class="form-control"
                   placeholder="e.g. Items seized at the scene" />
        </div>

        <div data-container="evidences">
            @for (var v = 0; v < Model.Evidences.Count; v++)
            {
                <partial name="_EvidenceRow" for="Evidences[v]" />
            }
        </div>

        <button type="button" class="btn btn-sm btn-outline-primary" data-action="add-evidence">
            Add evidence
        </button>
    </div>
</div>
