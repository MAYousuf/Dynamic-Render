@using Microsoft.AspNetCore.Mvc.Rendering
@model EvidenceInput
@{
    var prefix = Html.Name(string.Empty);

    var evidenceTypeOptions = ViewData["EvidenceTypeOptions"] as List<SelectListItem>
                              ?? new List<SelectListItem>();

    var optionsByEvidenceType = ViewData["InspectionTypeOptions"] as Dictionary<string, List<SelectListItem>>
                                ?? new Dictionary<string, List<SelectListItem>>();

    // Only the inspection types allowed for the evidence type this row currently holds. On a
    // template row that is nothing; Create.js fills the list in from the client config when an
    // evidence type is picked.
    var inspectionTypeOptions = new List<SelectListItem>();

    if (!string.IsNullOrWhiteSpace(Model.EvidenceTypeCode) &&
        optionsByEvidenceType.TryGetValue(Model.EvidenceTypeCode, out var allowed))
    {
        inspectionTypeOptions = allowed;
    }

    ViewData["RowInspectionTypeOptions"] = inspectionTypeOptions;
}

<div class="border rounded p-3 mb-3 bg-body-tertiary" data-row="evidence" data-prefix="@prefix">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="EvidenceTypeCode" class="form-label">Evidence type</label>

            @* Changing this re-resolves which inspection models apply, so Create.js repopulates the
               inspection types below and discards any data already captured under the old type. *@
            <select asp-for="EvidenceTypeCode" asp-items="evidenceTypeOptions"
                    class="form-select" data-select="evidence-type">
                <option value="">-- select --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="Description" class="form-label">Evidence description</label>
            <input asp-for="Description" class="form-control" data-field="description" />
        </div>
        <div class="col-md-2 text-end">
            <button type="button" class="btn btn-sm btn-outline-danger" data-action="remove-evidence">
                Remove
            </button>
        </div>
    </div>

    <hr />

    <p class="text-muted mb-0" data-empty-evidence-type
       hidden="@(string.IsNullOrWhiteSpace(Model.EvidenceTypeCode) ? null : "hidden")">
        Select an evidence type to see the inspections available for it.
    </p>

    <div data-evidence-inspections
         hidden="@(string.IsNullOrWhiteSpace(Model.EvidenceTypeCode) ? "hidden" : null)">
        <div data-container="inspections">
            @for (var i = 0; i < Model.Inspections.Count; i++)
            {
                <partial name="_InspectionRow" for="Inspections[i]" />
            }
        </div>

        <button type="button" class="btn btn-sm btn-outline-primary mt-2" data-action="add-inspection">
            Add inspection
        </button>
    </div>
</div>
