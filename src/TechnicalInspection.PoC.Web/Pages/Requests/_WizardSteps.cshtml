@{
    var steps = new[]
    {
        (Number: 1, Title: "Basic data"),
        (Number: 2, Title: "Exhibits, evidences & inspections"),
        (Number: 3, Title: "Inspection data")
    };
}

@* The whole wizard is one page, so which step is current is a client-side concern: this partial is
   inside the Vue root, and the state classes follow the app's `pane`. *@

<ol class="list-unstyled d-flex flex-wrap gap-2 mb-4">
    @foreach (var step in steps)
    {
        <li class="px-3 py-2 rounded" v-bind:class="stepClass(@step.Number)">
            <strong>Step @step.Number</strong>
            <span class="ms-1">@step.Title</span>
        </li>
    }
</ol>
