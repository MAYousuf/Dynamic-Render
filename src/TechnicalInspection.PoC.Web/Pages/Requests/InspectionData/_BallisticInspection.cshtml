@model TechnicalInspection.PoC.Requests.BallisticInspectionData

@* Strongly typed partial (section 15): a concrete @model, so asp-for gives compile-time checked
   expressions, IntelliSense and normal validation - not @model dynamic. *@

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="WeaponType" class="form-label"></label>
        <input asp-for="WeaponType" class="form-control" placeholder="e.g. Pistol" />
        <span asp-validation-for="WeaponType" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Caliber" class="form-label"></label>
        <input asp-for="Caliber" class="form-control" placeholder="e.g. 9mm" />
        <span asp-validation-for="Caliber" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" />
        <span asp-validation-for="SerialNumber" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="RoundsRecovered" class="form-label"></label>
        <input asp-for="RoundsRecovered" class="form-control" />
        <span asp-validation-for="RoundsRecovered" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Findings" class="form-label"></label>
        <textarea asp-for="Findings" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Findings" class="text-danger small"></span>
    </div>
</div>
